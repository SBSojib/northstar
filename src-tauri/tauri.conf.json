{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Northstar SSH",
  "version": "0.2.1",
  "identifier": "app.northstar.ssh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Northstar SSH",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "shortDescription": "A focused desktop SSH client",
    "category": "DeveloperTool"
  }
}
